<tr id="<%= dom_id(employee, :row) %>" class="border-b border-slate-100 hover:bg-slate-50/80">
  <td class="px-3 py-3 text-sm text-slate-900 font-medium"><%= employee.first_name %></td>
  <td class="px-3 py-3 text-sm text-slate-900 font-medium"><%= employee.last_name %></td>
  <td class="px-3 py-3 text-sm text-slate-700"><%= employee.job_title %></td>
  <td class="px-3 py-3 text-sm text-slate-700 tabular-nums"><%= number_to_currency(employee.salary, precision: 2) %></td>
  <td class="px-3 py-3 text-sm text-slate-700"><%= employee.country %></td>
  <td class="px-3 py-3 text-sm">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-slate-800 break-all"><%= employee.email %></span>
      <button
        type="button"
        class="shrink-0 rounded-md px-2 py-1 text-xs font-medium bg-slate-100 hover:bg-slate-200 text-slate-700"
        data-controller="copy-email"
        data-copy-email-address-value="<%= employee.email %>"
        data-action="copy-email#copy"
      >
        Copy
      </button>
    </div>
  </td>
  <td class="px-3 py-3 text-right text-sm whitespace-nowrap">
    <%= link_to "Edit", edit_employee_path(employee, q: q), class: "text-indigo-600 hover:text-indigo-500 font-medium mr-3", data: { turbo_frame: "employee_modal" } %>
    <%= button_to "Delete", employee_path(employee, q: q), method: :delete, form: { data: { turbo_confirm: "Delete this employee?" } }, class: "text-red-600 hover:text-red-500 font-medium bg-transparent border-0 cursor-pointer inline p-0" %>
  </td>
</tr>
