<div id="<%= dom_id employee %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">First name:</strong>
    <%= employee.first_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Last name:</strong>
    <%= employee.last_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Job title:</strong>
    <%= employee.job_title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Salary:</strong>
    <%= employee.salary %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Country:</strong>
    <%= employee.country %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Email:</strong>
    <%= employee.email %>
  </div>
</div>
