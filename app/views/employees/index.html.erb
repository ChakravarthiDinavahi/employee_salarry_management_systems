<% content_for :title, "HR Dashboard — Employees" %>

<div class="w-full max-w-7xl mx-auto">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Employees</h1>
      <p class="text-slate-600 mt-1 text-sm">Server-side pagination with Pagy — search updates this table only.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Salary insights", salary_insights_path, data: { turbo: false }, class: "rounded-lg px-4 py-2.5 bg-white border border-slate-200 text-slate-800 text-sm font-medium hover:bg-slate-50" %>
      <%= link_to "Add employee", new_employee_path(q: @q), class: "rounded-lg px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium", data: { turbo_frame: "employee_modal" } %>
    </div>
  </div>

  <%= turbo_frame_tag "employee_modal" %>

  <%= render "employees/table_frame", employees: @employees, pagy: @pagy, q: @q %>
</div>
