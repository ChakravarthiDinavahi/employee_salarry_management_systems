<% if notice.present? %>
  <p class="py-2 px-3 bg-emerald-50 text-emerald-800 font-medium rounded-lg border border-emerald-200" id="notice"><%= notice %></p>
<% end %>
<% if alert.present? %>
  <p class="py-2 px-3 bg-red-50 text-red-800 font-medium rounded-lg border border-red-200" id="alert"><%= alert %></p>
<% end %>
