<% content_for :title, "Salary insights" %>

<div class="w-full max-w-7xl mx-auto space-y-10 pb-16">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Salary insights</h1>
      <p class="text-slate-600 mt-1 text-sm">Aggregates from <code class="text-xs bg-slate-100 px-1 rounded">SalaryStatsQuery</code> — computed in the database.</p>
    </div>
    <%= link_to "Back to employees", root_path, data: { turbo: false }, class: "rounded-lg px-4 py-2.5 bg-white border border-slate-200 text-slate-800 text-sm font-medium hover:bg-slate-50 w-fit" %>
  </div>

  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-900 mb-4">Average salary by country</h2>
    <%= column_chart @avg_by_country, prefix: "$", thousands: ",", round: 0, height: "420px", colors: ["#4f46e5"] %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-900 mb-4">Min &amp; max salary by country</h2>
    <% min_data = @min_max_by_country.transform_values { |h| h[:min].to_f } %>
    <% max_data = @min_max_by_country.transform_values { |h| h[:max].to_f } %>
    <%= column_chart [
          { name: "Min", data: min_data },
          { name: "Max", data: max_data }
        ], prefix: "$", thousands: ",", round: 0, height: "420px", colors: ["#94a3b8", "#4f46e5"] %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-900 mb-2">Top combinations — job title &amp; country</h2>
    <p class="text-sm text-slate-500 mb-4">Showing the 18 highest average salaries (sample).</p>
    <%= bar_chart @avg_by_title_country, prefix: "$", thousands: ",", round: 0, height: "480px", colors: ["#0d9488"] %>
  </section>
</div>
